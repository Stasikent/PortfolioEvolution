{
  "name": "web-eras-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner && node scripts/finish-build.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "test:e2e": "node tests/regression.mjs",
    "test:media": "node tests/media.mjs",
    "test:content": "node tests/content.mjs",
    "test:accessibility": "node tests/accessibility.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "test:rag": "python backend/scripts/smoke-rag.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}
